# Frontend environment (copy to `.env` and adjust)
#
# Values are baked in when you run `npm start` / `npm run build`.
# Browsers cannot read .env at runtime.

# Nest API the browser should call (no trailing slash)
API_URL=http://localhost:3000

# Optional alias — generate-env.mjs also reads this
NG_APP_API_BASE_URL=http://localhost:3000

# Public site URL (optional)
PUBLIC_SITE_URL=http://localhost:4200
