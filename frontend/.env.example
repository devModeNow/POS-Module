# Used at build/serve time by @ngx-env/builder (dotenv under the hood).
# Browsers cannot read .env directly — values are baked in when you run `ng build` / Vercel deploy.
#
# Local: copy to `.env`
NG_APP_API_BASE_URL=http://localhost:3000
#
# Production (Vercel):
#   1. Prefer Project Settings → Environment Variables → NG_APP_API_BASE_URL=https://your-backend.up.railway.app
#   2. Or use committed `.env.production`
# Then Redeploy.
