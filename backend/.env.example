# Local development (Laragon / pgAdmin / self-hosted Postgres)
#
# Prefer DATABASE_URL. Discrete DB_* values are used when DATABASE_URL is unset.
# Copy this file to `.env` and adjust.

PORT=3000
NODE_ENV=development

# --- Local Postgres / pgAdmin ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cbis

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cbis
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# SSL is off for local Postgres. Supabase URLs enable SSL automatically.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Connection mode: local | supabase-pooler | supabase-direct
# Auto-detected from DATABASE_URL if omitted.
# DB_CONNECTION_MODE=local

# --- Supabase (optional) ---
# See backend/.env.supabase.example
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# DATABASE_DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_CONNECTION_MODE=supabase-pooler

JWT_SECRET=change-this-to-a-strong-secret
JWT_EXPIRES_IN=1h

# Comma-separated frontend origins allowed to call backend
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Backup storage directory (relative or absolute path)
BACKUP_STORAGE_PATH=./backups

# Path to pg_dump executable (defaults to 'pg_dump' if in PATH)
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
