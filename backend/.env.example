# Local development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cbis

# Production (example only - put this in .env.production or deployment env vars)
# DATABASE_URL=postgresql://postgres.badhwkvofjzyoeuhpkhp:<YOUR-PASSWORD>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Or use separate values instead of DATABASE_URL:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cbis
DB_USER=postgres
DB_PASSWORD=postgres

# SSL options for managed Postgres providers/poolers
# Set DB_SSL_REJECT_UNAUTHORIZED=false for providers that use a chain Node cannot verify locally (e.g. some pooler endpoints)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=change-this-to-a-strong-secret
JWT_EXPIRES_IN=1h

# Comma-separated frontend origins allowed to call backend (for production + local)
CORS_ORIGINS=http://localhost:4200

# Backup storage directory (relative or absolute path)
BACKUP_STORAGE_PATH=./backups

# Path to pg_dump executable (defaults to 'pg_dump' if in PATH)
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
