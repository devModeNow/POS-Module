# Self-hosted production. Copy to .env.production or use .env.docker on the server.

PORT=3000
NODE_ENV=production

# --- Local Postgres / pgAdmin ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cbis
DB_SCHEMA=public
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_MODE=local

# --- Or Supabase ---
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# DATABASE_DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_CONNECTION_MODE=supabase-pooler

JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=1h

CORS_ORIGINS=https://alingbeth-staging.webkodex.com
