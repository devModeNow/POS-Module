# Copy on the server and fill real values:
#   cp .env.docker.example .env.docker
#   nano .env.docker
#
# Then:
#   docker compose --env-file .env.docker up -d --build
#
# Never commit .env.docker (it is gitignored).

# =============================================================================
# Public URLs (must match Cloudflare Tunnel hostnames)
# =============================================================================
# Frontend build args + browser API base
API_URL=https://api-alingbeth-staging.webkodex.com
PUBLIC_SITE_URL=https://alingbeth-staging.webkodex.com

# Backend CORS (comma-separated exact origins)
CORS_ORIGINS=https://alingbeth-staging.webkodex.com

# Optional build stamp
# BUILD_ID=

# Docker network shared with the Cloudflare tunnel container
# Confirm:
#   docker inspect <tunnel-container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
DOCKER_NETWORK=app-tier

# =============================================================================
# Server
# =============================================================================
NODE_ENV=production
PORT=3000
BACKUP_STORAGE_PATH=/app/backups

# =============================================================================
# PostgreSQL — pick ONE of the two blocks
# =============================================================================

# --- A) Local Postgres / pgAdmin (Docker network host is usually "db") ---
# DATABASE_URL=postgresql://USER:PASSWORD@db:5432/cbis
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=cbis
# DB_USER=USER
# DB_PASSWORD=PASSWORD
# DB_SCHEMA=public
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_CONNECTION_MODE=local

# --- B) Supabase (transaction pooler for the API; direct URL for pg_dump) ---
# Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DB_SCHEMA=public
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_CONNECTION_MODE=supabase-pooler

# =============================================================================
# Auth
# =============================================================================
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
